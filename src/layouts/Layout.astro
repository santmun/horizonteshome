---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HorizontesHome — El equipo que contesta todos tus mensajes',
  description =
    'Instalamos el sistema de agentes de venta por chat de tu inmobiliaria en WhatsApp, Instagram y Facebook. Califica compradores, agenda visitas y te pasa el cliente listo. En menos de 3 días.',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3f2f2" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23f3f2f2'/%3E%3Crect x='22' y='22' width='56' height='56' fill='%23ec3013'/%3E%3C/svg%3E"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'HorizontesHome',
        description,
        areaServed: 'Latinoamérica',
        serviceType: 'Agentes de venta por chat para inmobiliarias',
      })}
    />
  </head>
  <body class="antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-red focus:px-4 focus:py-2 focus:font-semibold focus:text-paper"
      >Saltar al contenido</a
    >
    <slot />

    <script is:inline>
      // Aparición de secciones al entrar en pantalla
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08 }
        );
        els.forEach((el) => {
          // Lo que ya quedó arriba del viewport se muestra sin esperar
          const r = el.getBoundingClientRect();
          if (r.bottom < 0 || r.top < window.innerHeight * 0.92) el.classList.add('is-visible');
          else io.observe(el);
        });
      })();
    </script>
  </body>
</html>
