---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Reencuadre from '../components/Reencuadre.astro';
import QueHace from '../components/QueHace.astro';
import Canales from '../components/Canales.astro';
import Panel from '../components/Panel.astro';
import Limites from '../components/Limites.astro';
import Proceso from '../components/Proceso.astro';
import ParaQuien from '../components/ParaQuien.astro';
import Faq from '../components/Faq.astro';
import Aplicar from '../components/Aplicar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="contenido">
    <Hero />
    <Problema />
    <Reencuadre />
    <QueHace />
    <Canales />
    <Panel />
    <Limites />
    <Proceso />
    <ParaQuien />
    <Faq />
    <Aplicar />
  </main>
  <Footer />
</Layout>
