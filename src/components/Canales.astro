---
import SectionHead from './SectionHead.astro';

const canales = [
  {
    nombre: 'WhatsApp',
    nota: 'Tu mismo número de siempre. Tus clientes no notan ningún cambio.',
    color: '#25D366',
    icon: 'M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.4A10 10 0 1 0 12 2m0 2a8 8 0 1 1-4.2 14.8l-.3-.2-2.6.8.8-2.5-.2-.3A8 8 0 0 1 12 4m-3 4c-.3 0-.6.1-.8.4-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3-1.5-.7c-.2 0-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4z',
  },
  {
    nombre: 'Instagram',
    nota: 'Contesta los DM y también a quien comenta tus publicaciones.',
    color: '#E1306C',
    icon: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2 0 1.8.2 2.2.4.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1a3.8 3.8 0 0 1-1-1.4c-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1m0 3.3a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13m0 2.3a4.2 4.2 0 1 1 0 8.4 4.2 4.2 0 0 1 0-8.4m6.8-2.6a1.5 1.5 0 1 0-3 0 1.5 1.5 0 0 0 3 0',
  },
  {
    nombre: 'Facebook',
    nota: 'Los mensajes de tu página y de tus anuncios, atendidos al instante.',
    color: '#1877F2',
    icon: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12',
  },
  {
    nombre: 'Tu página web',
    nota: 'Una burbuja de chat en tu sitio. El que estaba viendo fotos ya no se va sin escribir.',
    color: '#ec3013',
    icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 2c1.3 0 2.8 2.2 3.3 5.2H8.7C9.2 6.2 10.7 4 12 4M6.4 6.6A13 13 0 0 0 6 9.2H4.3a8 8 0 0 1 2.1-2.6M4.3 14.8H6c.1 1 .2 1.8.4 2.6a8 8 0 0 1-2.1-2.6m1.5-2c0-.9.1-1.8.2-2.6h2.1a24 24 0 0 0 0 5.2H6c-.1-.8-.2-1.7-.2-2.6m6.2 7.2c-1.3 0-2.8-2.2-3.3-5.2h6.6c-.5 3-2 5.2-3.3 5.2m3.6-7.2H8.4a22 22 0 0 1 0-5.2h7.2a22 22 0 0 1 0 5.2m2 5c.2-.8.3-1.7.4-2.6h1.7a8 8 0 0 1-2.1 2.6m.4-4.6a24 24 0 0 0 0-5.2h2.1c.2.8.3 1.7.3 2.6s-.1 1.8-.3 2.6z',
  },
  {
    nombre: 'Telegram',
    nota: 'Por si tu mercado o tu equipo lo usa.',
    color: '#229ED9',
    icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m4.6 6.8-1.5 7.3c-.1.5-.4.6-.9.4l-2.4-1.8-1.2 1.1c-.1.1-.3.3-.6.3l.2-2.4 4.4-4c.2-.2 0-.3-.3-.1L8.7 13l-2.3-.7c-.5-.2-.5-.5.1-.8l9-3.5c.4-.2.8.1.6.8',
  },
];
---

<section id="canales" class="relative overflow-hidden">
  <div class="mx-auto max-w-[1360px] px-5 py-24 sm:px-8">
    <SectionHead
      kicker="Dónde trabaja"
      title="Donde ya te escriben tus clientes. No los mandamos a otro lado."
      lead="Nadie va a descargar una app para preguntarte por una casa. Tus agentes trabajan en los mismos canales que ya usas, con tus mismas cuentas, y todo llega a un solo lugar."
    />

    <div data-reveal class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        canales.map((c) => (
          <div class="group flex items-start gap-4 rounded-3xl border border-line bg-surface p-7 transition duration-300 hover:-translate-y-1 hover:border-transparent hover:bg-paper hover:shadow-soft">
            <span
              class="grid size-12 flex-none place-items-center rounded-full transition group-hover:scale-110"
              style={`background:${c.color}1f`}>
              <svg viewBox="0 0 24 24" class="size-6" style={`fill:${c.color}`} aria-hidden="true">
                <path d={c.icon} />
              </svg>
            </span>
            <div>
              <h3 class="display text-[23px]">{c.nombre}</h3>
              <p class="mt-1.5 text-[14.5px] leading-[1.6] text-mute-700">{c.nota}</p>
            </div>
          </div>
        ))
      }

      <div class="relative overflow-hidden rounded-3xl bg-red p-8 text-paper shadow-soft">
        <div
          class="pointer-events-none absolute -bottom-14 -right-10 size-44 rounded-full border-2 border-paper/30"
          aria-hidden="true">
        </div>
        <h3 class="display relative text-[25px] leading-[1.1]">Todo cae en una sola bandeja</h3>
        <p class="relative mt-2.5 text-[14.5px] leading-[1.6] text-paper/90">
          No importa por dónde te escribieron: tú y tu equipo lo ven todo junto, con el historial
          completo de cada cliente.
        </p>
      </div>
    </div>
  </div>
</section>
