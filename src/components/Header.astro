---
const links = [
  { href: '#problema', label: 'El problema' },
  { href: '#que-hace', label: 'Qué hace' },
  { href: '#canales', label: 'Dónde trabaja' },
  { href: '#proceso', label: 'Cómo lo instalamos' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header class="sticky top-0 z-40 border-b border-ink-100 bg-ink-50/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3.5">
    <a href="#top" class="flex shrink-0 items-center gap-2.5" aria-label="HorizontesHome, inicio">
      <span class="grid size-9 place-items-center rounded-xl bg-brand-600 text-white">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
          <path
            d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"
            fill="currentColor"></path>
        </svg>
      </span>
      <span class="text-[17px] font-semibold tracking-tight">
        Horizontes<span class="text-brand-600">Home</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Secciones">
      {
        links.map((l) => (
          <a href={l.href} class="text-sm text-ink-700 transition hover:text-brand-700">
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#aplicar"
      class="shrink-0 rounded-xl bg-ink-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-700"
      >Aplicar</a
    >
  </div>
</header>
