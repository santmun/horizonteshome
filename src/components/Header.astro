---
const links = [
  { href: '#problema', label: 'El problema' },
  { href: '#que-hace', label: 'Qué hace' },
  { href: '#canales', label: 'Dónde trabaja' },
  { href: '#panel', label: 'El panel' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header class="sticky top-0 z-60 border-b-2 border-line bg-paper">
  <div class="mx-auto flex max-w-[1360px] items-stretch justify-between gap-8 px-5 sm:px-8">
    <a
      href="#top"
      class="flex shrink-0 items-center gap-2.5 py-4 text-[19px] font-extrabold tracking-[-.02em]"
      aria-label="HorizontesHome, inicio">
      <span class="block size-[22px] rounded-md bg-red"></span>
      HORIZONTES<span class="text-red">HOME</span>
    </a>

    <nav class="hidden items-center text-[13px] font-semibold lg:flex" aria-label="Secciones">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            class:list={[
              'border-l border-line px-[18px] transition-colors hover:text-red',
              i === links.length - 1 && 'border-r',
            ]}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#aplicar"
      class="my-auto shrink-0 rounded-lg bg-red px-[22px] py-3 text-sm font-extrabold text-paper transition-colors hover:bg-red-600"
      >Aplicar</a
    >
  </div>
</header>
