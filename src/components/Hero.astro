---
import { Image } from 'astro:assets';
import fondo from '../assets/hero-casa-noche.png';

const puntos = [
  { n: '01', t: 'Contesta en segundos, a cualquier hora' },
  { n: '02', t: 'Nunca inventa una propiedad ni un precio' },
  { n: '03', t: 'Funcionando en menos de tres días' },
];
---

<section id="top" class="relative">
  <div class="relative min-h-[92vh] overflow-hidden bg-ink">
    <Image
      src={fondo}
      alt=""
      widths={[900, 1400, 2000, 2752]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover object-right"
    />
    <!-- Capa negra: contraste parejo sin apagar la foto -->
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <!-- Refuerzo del lado del texto para que el titular siempre gane -->
    <div
      class="absolute inset-0 [background:linear-gradient(100deg,rgba(0,0,0,.78)_0%,rgba(0,0,0,.6)_38%,rgba(0,0,0,.2)_66%,transparent_88%)]"
      aria-hidden="true">
    </div>
    <div
      class="absolute inset-0 [background:linear-gradient(0deg,rgba(0,0,0,.5)_0%,transparent_38%)]"
      aria-hidden="true">
    </div>

    <div
      class="pointer-events-none absolute -right-32 top-[-14%] size-[620px] rounded-full border border-paper/15"
      aria-hidden="true">
    </div>

    <div
      class="animate-rise relative mx-auto flex min-h-[92vh] max-w-[1360px] flex-col justify-center px-5 pb-40 pt-28 sm:px-8">
      <div class="flex items-center gap-3.5 text-[12px] font-extrabold tracking-[.16em] text-red-400">
        <span class="animate-drawline block h-0.5 w-10 rounded-full bg-red"></span>
        PARA INMOBILIARIAS Y DESARROLLADORES
      </div>

      <h1 class="display mt-7 max-w-[17ch] text-[clamp(44px,6.6vw,102px)] leading-[0.98] text-paper">
        Tu próximo cliente escribió a las 11 de la noche.
        <span class="mt-1 block text-red-500">Alguien tiene que contestarle.</span>
      </h1>

      <p class="mt-8 max-w-[520px] text-[17px] leading-[1.62] text-paper/85">
        Instalamos el equipo de agentes que atiende el WhatsApp, el Instagram y el Facebook de tu
        inmobiliaria. Reciben al interesado, entienden qué busca, agendan la visita y te lo entregan
        listo para cerrar.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#aplicar"
          class="rounded-full bg-red px-8 py-4.5 text-center text-[15px] font-extrabold text-paper shadow-lift transition hover:-translate-y-0.5 hover:bg-red-600">
          Aplicar para mi inmobiliaria
        </a>
        <a
          href="#que-hace"
          class="rounded-full border border-paper/45 px-8 py-4.5 text-center text-[15px] font-extrabold text-paper transition hover:bg-paper/10">
          Ver cómo funciona
        </a>
      </div>
    </div>
  </div>

  <!-- Tarjeta flotante montada sobre la foto -->
  <div class="relative mx-auto -mt-28 max-w-[1240px] px-5 sm:px-8">
    <div class="grid overflow-hidden rounded-3xl bg-paper shadow-lift sm:grid-cols-2 lg:grid-cols-4">
      {
        puntos.map((p) => (
          <div class="border-b border-line px-7 py-7 last:border-b-0 sm:border-r lg:border-b-0">
            <div class="text-[11px] font-extrabold tracking-[.14em] text-red">{p.n}</div>
            <div class="mt-2.5 text-[17px] font-extrabold leading-[1.22]">{p.t}</div>
          </div>
        ))
      }
      <div class="flex items-center bg-surface px-7 py-7">
        <p class="text-[13.5px] leading-[1.5] text-mute-700">
          Trabajamos con pocas inmobiliarias a la vez. <strong class="text-ink">Por eso se aplica.</strong>
        </p>
      </div>
    </div>
  </div>
</section>
