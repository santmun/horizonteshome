---
import SectionHead from './SectionHead.astro';

const si = [
  'Recibes al menos 30 mensajes de clientes al mes entre todos tus canales',
  'Tienes un inventario de propiedades, aunque viva en un Excel',
  'Ya inviertes en anuncios o en portales y te duele que un lead se enfríe',
  'Tienes un equipo (aunque sean dos asesores) que puede atender lo que te pasemos',
  'Quieres saber, por fin, cuántos clientes tocan la puerta cada mes',
];

const no = [
  'Buscas que alguien cierre las ventas por ti: eso no lo hace nadie más que tu equipo',
  'No tienes propiedades propias ni acceso a un inventario que podamos usar',
  'Quieres algo listo hoy mismo sin poder darnos una hora de tu tiempo',
  'Esperas resultados sin que nadie de tu lado conteste cuando te pasamos un cliente caliente',
];
---

<section class="border-b-2 border-line">
  <div class="mx-auto max-w-[1360px] px-5 pt-20 sm:px-8">
    <SectionHead
      kicker="Antes de aplicar"
      title="Esto no le sirve a todas las inmobiliarias"
      lead="Preferimos decírtelo aquí y no en la llamada. Tomamos pocas inmobiliarias a la vez porque cada sistema lo armamos a mano con tu información."
    />
  </div>

  <div data-reveal class="mt-14 grid border-t-2 border-line lg:grid-cols-2">
    <div class="border-b border-line px-6 pb-11 pt-9 sm:px-8 lg:border-b-0 lg:border-r">
      <h3 class="display text-[28px] text-red-700">Aplica si…</h3>
      <ul class="mt-5">
        {
          si.map((t) => (
            <li class="grid grid-cols-[24px_1fr] gap-3 border-t border-line py-3.5 text-[15px] leading-[1.55]">
              <span class="font-extrabold text-red" aria-hidden="true">
                →
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="px-6 pb-11 pt-9 text-mute-700 sm:px-8">
      <h3 class="display text-[28px] text-mute-500">Mejor no apliques si…</h3>
      <ul class="mt-5">
        {
          no.map((t) => (
            <li class="grid grid-cols-[24px_1fr] gap-3 border-t border-line py-3.5 text-[15px] leading-[1.55]">
              <span class="font-extrabold text-mute-500" aria-hidden="true">
                ×
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
