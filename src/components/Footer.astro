---
const año = new Date().getFullYear();

const secciones = [
  { href: '#problema', label: 'El problema' },
  { href: '#que-hace', label: 'Qué hace' },
  { href: '#panel', label: 'El panel' },
  { href: '#proceso', label: 'Cómo lo instalamos' },
];

const contacto = [
  { href: 'mailto:contacto@innovandohorizontes.com', label: 'contacto@innovandohorizontes.com' },
  { href: '#aplicar', label: 'Aplicar' },
  { href: '#preguntas', label: 'Preguntas frecuentes' },
];
---

<footer class="bg-paper">
  <div class="mx-auto grid max-w-[1360px] gap-12 px-5 pb-7 pt-14 sm:grid-cols-2 sm:px-8 lg:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5 text-[19px] font-extrabold tracking-[-.02em]">
        <span class="block size-[22px] bg-red"></span>
        HORIZONTES<span class="text-red">HOME</span>
      </div>
      <p class="mt-4 max-w-[340px] text-[14.5px] leading-[1.62] text-mute-700">
        Instalamos sistemas de agentes de venta por chat para inmobiliarias de Latinoamérica. Tus
        canales, tu inventario, tu marca.
      </p>
    </div>

    <div>
      <div class="micro text-mute-700">Secciones</div>
      <div class="mt-3.5 grid gap-2 text-sm">
        {secciones.map((s) => <a href={s.href} class="transition-colors hover:text-red">{s.label}</a>)}
      </div>
    </div>

    <div>
      <div class="micro text-mute-700">Contacto</div>
      <div class="mt-3.5 grid gap-2 text-sm">
        {contacto.map((c) => <a href={c.href} class="transition-colors hover:text-red">{c.label}</a>)}
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1360px] px-5 pb-10 sm:px-8">
    <div
      class="flex flex-col justify-between gap-3 border-t-2 border-line pt-4.5 text-xs text-mute-700 sm:flex-row">
      <span>© {año} HorizontesHome. Todos los derechos reservados.</span>
      <span>Hecho para inmobiliarias que no quieren perder un solo mensaje.</span>
    </div>
  </div>
</footer>
