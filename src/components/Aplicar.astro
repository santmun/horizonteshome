---
// Definición del wizard. Cada paso agrupa campos; el orden aquí es el orden en pantalla
// y también el orden del correo que llega a contacto@.
// `grupo` mapea el paso a las tres pestañas del encabezado del rediseño.
const pasos = [
  {
    id: 'negocio',
    grupo: 0,
    titulo: 'Tu inmobiliaria',
    ayuda: 'Lo básico para saber con quién estamos hablando.',
    campos: [
      { name: 'inmobiliaria', label: '¿Cómo se llama tu inmobiliaria?', type: 'text', required: true, placeholder: 'Inmobiliaria Herrera' },
      { name: 'ciudad', label: '¿En qué ciudad y país operan?', type: 'text', required: true, placeholder: 'Monterrey, México' },
      { name: 'sitio', label: 'Tu página web o tu Instagram', type: 'text', required: false, placeholder: 'inmobiliariaherrera.com o @inmoherrera', nota: 'Si no tienes, déjalo vacío.' },
      {
        name: 'antiguedad', label: '¿Cuánto llevan operando?', type: 'radio', required: true,
        opciones: ['Menos de 1 año', '1 a 3 años', '3 a 10 años', 'Más de 10 años'],
      },
    ],
  },
  {
    id: 'operacion',
    grupo: 0,
    titulo: 'Cómo es tu operación',
    ayuda: 'Esto define el tamaño del sistema que necesitas.',
    campos: [
      {
        name: 'asesores', label: '¿Cuántos asesores tienen hoy?', type: 'radio', required: true,
        opciones: ['Solo yo', '2 a 5', '6 a 15', 'Más de 15'],
      },
      {
        name: 'propiedades', label: '¿Cuántas propiedades manejan al mismo tiempo?', type: 'radio', required: true,
        opciones: ['Menos de 20', '20 a 100', '100 a 500', 'Más de 500'],
      },
      {
        name: 'operacion_tipo', label: '¿A qué se dedican principalmente?', type: 'radio', required: true,
        opciones: ['Venta', 'Renta', 'Las dos por igual', 'Desarrollo propio'],
      },
      {
        name: 'segmento', label: '¿Qué tipo de propiedades? (marca todas las que apliquen)', type: 'checkbox', required: true,
        opciones: ['Casas', 'Departamentos', 'Terrenos', 'Locales y oficinas', 'Naves industriales', 'Preventa / desarrollos'],
      },
    ],
  },
  {
    id: 'atencion',
    grupo: 1,
    titulo: 'Cómo atienden hoy',
    ayuda: 'La parte que más nos dice si te podemos ayudar.',
    campos: [
      {
        name: 'canales', label: '¿Por dónde te escriben tus clientes? (marca todos)', type: 'checkbox', required: true,
        opciones: ['WhatsApp', 'Instagram', 'Facebook Messenger', 'Llamadas', 'Formulario de mi web', 'Portales (Inmuebles24, Lamudi...)'],
      },
      {
        name: 'volumen', label: '¿Cuántos mensajes nuevos reciben por semana, más o menos?', type: 'radio', required: true,
        opciones: ['Menos de 10', '10 a 50', '50 a 200', 'Más de 200', 'No tengo idea'],
      },
      {
        name: 'quien_contesta', label: '¿Quién contesta hoy?', type: 'radio', required: true,
        opciones: ['Yo mismo', 'Cada asesor su celular', 'Una persona dedicada', 'Una agencia externa', 'Casi nadie, es el problema'],
      },
      {
        name: 'tiempo_respuesta', label: '¿En cuánto tiempo contestan normalmente?', type: 'radio', required: true,
        opciones: ['En minutos', 'En unas horas', 'Al día siguiente', 'Depende del día', 'Se nos van varios sin contestar'],
      },
      {
        name: 'invierte_ads', label: '¿Invierten en publicidad para conseguir clientes?', type: 'radio', required: true,
        opciones: ['Sí, cada mes', 'A veces', 'No, todo es referido y orgánico'],
      },
    ],
  },
  {
    id: 'herramientas',
    grupo: 1,
    titulo: 'Con qué trabajan',
    ayuda: 'Para conectar el sistema con lo que ya usas, no cambiarte de todo.',
    campos: [
      {
        name: 'inventario', label: '¿Dónde vive tu inventario de propiedades?', type: 'radio', required: true,
        opciones: ['Excel o Google Sheets', 'En mi página web', 'En un CRM', 'En los portales nada más', 'En la cabeza del equipo'],
      },
      { name: 'crm', label: '¿Usan algún CRM o sistema? ¿Cuál?', type: 'text', required: false, placeholder: 'EasyBroker, Wasi, HubSpot... o "ninguno"' },
      {
        name: 'idiomas', label: '¿Necesitas que atienda en otro idioma además de español?', type: 'radio', required: true,
        opciones: ['Solo español', 'Español e inglés', 'Otro idioma'],
      },
    ],
  },
  {
    id: 'objetivo',
    grupo: 1,
    titulo: 'Qué quieres resolver',
    ayuda: 'Sé lo más concreto que puedas: esto es lo que leemos primero.',
    campos: [
      {
        name: 'objetivo', label: '¿Qué es lo que más te urge? (marca hasta 2)', type: 'checkbox', required: true,
        opciones: [
          'Que nadie se quede sin respuesta',
          'Que me lleguen leads ya calificados',
          'Agendar más visitas',
          'Dejar de perder los leads de la publicidad',
          'Ordenar y ver todo en un solo lugar',
          'Que mi equipo deje de repetir lo mismo',
        ],
      },
      { name: 'preguntas_frecuentes', label: '¿Qué es lo que más te preguntan tus clientes?', type: 'textarea', required: true, placeholder: 'Precio, si sigue disponible, si aceptan Infonavit, cuánto de enganche...' },
      { name: 'contexto', label: '¿Algo más que debamos saber?', type: 'textarea', required: false, placeholder: 'Lo que sea: intentos anteriores, cómo trabaja tu equipo, temas que jamás debe tocar el sistema.' },
      {
        name: 'arranque', label: '¿Para cuándo lo quieres funcionando?', type: 'radio', required: true,
        opciones: ['Esta semana', 'Este mes', 'En los próximos 3 meses', 'Solo estoy explorando'],
      },
      {
        name: 'presupuesto', label: '¿Con qué presupuesto cuentas para resolverlo?', type: 'radio', required: true,
        opciones: ['Menos de $1,000 USD', '$1,000 a $3,000 USD', '$3,000 a $8,000 USD', 'Más de $8,000 USD', 'Necesito que me orienten'],
        nota: 'Nos ayuda a proponerte algo realista desde la primera llamada. No es un compromiso.',
      },
    ],
  },
  {
    id: 'contacto',
    grupo: 2,
    titulo: 'Cómo te contactamos',
    ayuda: 'Último paso. Revisamos las solicitudes y respondemos en 24 horas hábiles.',
    campos: [
      { name: 'nombre', label: 'Tu nombre completo', type: 'text', required: true, placeholder: 'Miguel Herrera' },
      { name: 'rol', label: '¿Cuál es tu rol?', type: 'radio', required: true, opciones: ['Dueño o socio', 'Director o gerente', 'Asesor', 'Marketing'] },
      { name: 'email', label: 'Tu correo', type: 'email', required: true, placeholder: 'miguel@inmobiliaria.com' },
      { name: 'whatsapp', label: 'Tu WhatsApp (con código de país)', type: 'tel', required: true, placeholder: '+52 81 1234 5678' },
    ],
  },
];

const grupos = ['01 · Tu inmobiliaria', '02 · Cómo vendes', '03 · Contacto'];

const input =
  'mt-2.5 w-full rounded-lg border border-line bg-white px-3.5 py-3.5 text-[15px] outline-none transition-colors placeholder:text-mute-400 focus:border-red';
const etiqueta = 'block text-xs font-extrabold uppercase tracking-[.1em] text-mute-700';
---

<section id="aplicar" class="relative overflow-hidden border-b-2 border-line bg-ink text-paper">
  <div
    class="absolute inset-0 bg-[#2b2928] [background-image:repeating-linear-gradient(58deg,rgba(255,255,255,.07)_0_3px,transparent_3px_18px)] [filter:grayscale(1)]"
    aria-hidden="true">
  </div>
  <div
    class="absolute -bottom-56 -left-44 size-[520px] rounded-full border-2 border-paper/20"
    aria-hidden="true">
  </div>

  <div class="relative mx-auto grid max-w-[1360px] items-start gap-16 px-5 py-20 pb-22 sm:px-8 lg:grid-cols-[minmax(320px,1fr)_minmax(0,1.25fr)]">
    <div>
      <div class="kicker text-red-500">La solicitud</div>
      <h2 class="display mt-4 text-[clamp(32px,4vw,56px)] text-paper">Cuéntanos de tu inmobiliaria</h2>
      <p class="mt-5 max-w-[420px] text-base leading-[1.68] text-paper/70">
        Cinco minutos. Si encajamos, te llamamos y te decimos con honestidad si esto te sirve. Si no,
        también te lo decimos.
      </p>
      <ul class="mt-8 border-t border-paper/25">
        {
          [
            'Trabajamos con pocas inmobiliarias a la vez',
            'Respondemos en menos de 24 horas hábiles',
            'Sin compromiso y sin llamada de ventas eterna',
          ].map((t, i) => (
            <li class:list={['py-3.5 text-sm text-paper/70', i < 2 && 'border-b border-paper/25']}>{t}</li>
          ))
        }
      </ul>
    </div>

    <div class="overflow-hidden rounded-xl border-2 border-paper/30 bg-paper text-ink">
      <!-- Encabezado de grupos -->
      <div class="flex border-b-2 border-line" data-grupos>
        {
          grupos.map((g, i) => (
            <div
              data-grupo={i}
              class:list={[
                'micro flex-1 px-3 py-3.5 sm:px-4.5',
                i > 0 && 'border-l border-line',
                i === 0 ? 'bg-ink text-paper' : 'text-mute-700',
              ]}>
              {g}
            </div>
          ))
        }
      </div>

      <form id="form-aplicar" novalidate>
        <!-- trampa para bots -->
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label>No llenar<input type="text" name="empresa_web" tabindex="-1" autocomplete="off" /></label>
        </div>

        {
          pasos.map((paso, i) => (
            <fieldset class:list={['px-6 py-7 sm:px-7', i > 0 && 'hidden']} data-paso={i}>
              <legend class="sr-only">{paso.titulo}</legend>
              <p class="display text-[26px] leading-tight">{paso.titulo}</p>
              <p class="mt-1.5 text-sm text-mute-700">{paso.ayuda}</p>

              <div class="mt-7 grid gap-6">
                {paso.campos.map((campo) => (
                  <div data-campo={campo.name}>
                    <label
                      class={etiqueta}
                      for={['text', 'email', 'tel', 'textarea'].includes(campo.type) ? `f-${campo.name}` : undefined}>
                      {campo.label}
                      {!campo.required && <span class="ml-1.5 font-semibold normal-case tracking-normal text-mute-500">(opcional)</span>}
                    </label>
                    {campo.nota && <p class="mt-1.5 text-[13px] leading-relaxed text-mute-500">{campo.nota}</p>}

                    {['text', 'email', 'tel'].includes(campo.type) && (
                      <input
                        id={`f-${campo.name}`}
                        type={campo.type}
                        name={campo.name}
                        placeholder={campo.placeholder}
                        required={campo.required}
                        autocomplete={campo.type === 'email' ? 'email' : campo.type === 'tel' ? 'tel' : 'off'}
                        class={input}
                      />
                    )}

                    {campo.type === 'textarea' && (
                      <textarea
                        id={`f-${campo.name}`}
                        name={campo.name}
                        rows="3"
                        placeholder={campo.placeholder}
                        required={campo.required}
                        class:list={[input, 'resize-y']}
                      />
                    )}

                    {(campo.type === 'radio' || campo.type === 'checkbox') && (
                      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={campo.label}>
                        {campo.opciones?.map((op, oi) => (
                          <label class="cursor-pointer">
                            <input
                              type={campo.type}
                              name={campo.name}
                              value={op}
                              id={`f-${campo.name}-${oi}`}
                              data-required={campo.required ? 'si' : undefined}
                              class="peer sr-only"
                            />
                            <span class="inline-block rounded-lg border border-line bg-white px-3.5 py-2.5 text-[13.5px] transition-colors hover:border-ink peer-checked:border-ink peer-checked:bg-ink peer-checked:font-semibold peer-checked:text-paper peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-red">
                              {op}
                            </span>
                          </label>
                        ))}
                      </div>
                    )}

                    <p class="mt-2 hidden text-[13px] font-extrabold text-red" data-error>
                      Nos falta este dato.
                    </p>
                  </div>
                ))}
              </div>
            </fieldset>
          ))
        }

        <!-- Resumen -->
        <fieldset class="hidden px-6 py-7 sm:px-7" data-paso={pasos.length}>
          <legend class="sr-only">Revisa tu solicitud</legend>
          <p class="display text-[26px] leading-tight">Revisa antes de enviar</p>
          <p class="mt-1.5 text-sm text-mute-700">
            Si algo no quedó bien, regresa y cámbialo. Nadie ve esto más que nosotros.
          </p>
          <dl class="mt-6 border-t border-line" data-resumen></dl>

          <label class="mt-6 flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-mute-700">
            <input
              type="checkbox"
              name="acepto"
              required
              class="mt-0.5 size-4 shrink-0 accent-[var(--color-red)]"
            />
            <span>
              Acepto que HorizontesHome me contacte por correo o WhatsApp sobre esta solicitud. No
              compartimos tus datos con nadie más.
            </span>
          </label>
          <p class="mt-2 hidden text-[13px] font-extrabold text-red" data-error-acepto>
            Necesitamos tu permiso para poder contactarte.
          </p>
        </fieldset>

        <!-- Navegación -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-t-2 border-line px-6 py-4.5 sm:px-7">
          <button
            type="button"
            data-atras
            class="cursor-pointer rounded-lg border border-line px-5.5 py-3 text-sm font-extrabold transition-colors hover:bg-surface disabled:invisible">
            Atrás
          </button>
          <div class="order-last w-full text-center text-[12.5px] text-mute-700 sm:order-none sm:w-auto">
            Paso <span data-paso-actual>1</span> de {pasos.length + 1}
          </div>
          <button
            type="button"
            data-siguiente
            class="cursor-pointer rounded-lg bg-red px-6.5 py-3.25 text-sm font-extrabold text-paper transition-colors hover:bg-red-600">
            Siguiente
          </button>
          <button
            type="submit"
            data-enviar
            class="hidden cursor-pointer rounded-lg bg-red px-6.5 py-3.25 text-sm font-extrabold text-paper transition-colors hover:bg-red-600 disabled:opacity-60">
            Enviar solicitud
          </button>
        </div>
      </form>

      <!-- Éxito -->
      <div class="hidden px-6 py-16 text-center sm:px-7" data-exito>
        <span class="mx-auto grid size-14 place-items-center rounded-xl bg-red text-paper">
          <svg viewBox="0 0 20 20" class="size-7" fill="currentColor" aria-hidden="true">
            <path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z"></path>
          </svg>
        </span>
        <h3 class="display mt-6 text-[30px]">Recibimos tu solicitud</h3>
        <p class="mx-auto mt-4 max-w-md leading-relaxed text-mute-700">
          La revisamos con calma y te escribimos en menos de 24 horas hábiles. Si encajamos, en ese
          mismo correo te mandamos el link para agendar la llamada de 30 minutos.
        </p>
      </div>

      <!-- Error de envío -->
      <div class="hidden border-t-2 border-line bg-red-200 px-6 py-4.5 text-sm leading-relaxed text-red-800 sm:px-7" data-fallo>
        No pudimos enviar tu solicitud. Escríbenos directo a
        <a href="mailto:contacto@innovandohorizontes.com" class="font-extrabold underline">contacto@innovandohorizontes.com</a>
        y lo resolvemos.
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('form-aplicar') as HTMLFormElement | null;
  if (form) {
    const tarjeta = form.parentElement!;
    const fieldsets = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-paso]'));
    const total = fieldsets.length;
    // Qué grupo del encabezado ilumina cada paso (el resumen cae en el último)
    const GRUPO_POR_PASO = [0, 0, 1, 1, 1, 2, 2];
    const btnAtras = form.querySelector<HTMLButtonElement>('[data-atras]')!;
    const btnSig = form.querySelector<HTMLButtonElement>('[data-siguiente]')!;
    const btnEnviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    const numPaso = form.querySelector<HTMLElement>('[data-paso-actual]')!;
    const resumen = form.querySelector<HTMLElement>('[data-resumen]')!;
    const exito = tarjeta.querySelector<HTMLElement>('[data-exito]')!;
    const fallo = tarjeta.querySelector<HTMLElement>('[data-fallo]')!;
    const cabecera = tarjeta.querySelector<HTMLElement>('[data-grupos]')!;
    const gruposEl = Array.from(cabecera.querySelectorAll<HTMLElement>('[data-grupo]'));
    const CLAVE = 'hh-aplicacion';

    let actual = 0;

    // ---- Persistencia local, por si cierran la pestaña a medias
    const guardar = () => {
      const datos: Record<string, string[]> = {};
      new FormData(form).forEach((v, k) => {
        if (typeof v !== 'string' || k === 'empresa_web') return;
        (datos[k] ||= []).push(v);
      });
      try {
        localStorage.setItem(CLAVE, JSON.stringify(datos));
      } catch {}
    };

    const restaurar = () => {
      let datos: Record<string, string[]>;
      try {
        datos = JSON.parse(localStorage.getItem(CLAVE) || '{}');
      } catch {
        return;
      }
      for (const [k, valores] of Object.entries(datos)) {
        for (const val of valores) {
          const campos = form.querySelectorAll<HTMLInputElement>(`[name="${CSS.escape(k)}"]`);
          for (const campo of campos) {
            if (campo.type === 'radio' || campo.type === 'checkbox') {
              if (campo.value === val) campo.checked = true;
            } else {
              campo.value = val;
            }
          }
        }
      }
    };

    form.addEventListener('input', guardar);
    form.addEventListener('change', guardar);
    restaurar();

    // ---- Validación por paso
    const validarPaso = (i: number) => {
      const fs = fieldsets[i];
      let ok = true;
      let primerFallo: HTMLElement | null = null;

      fs.querySelectorAll<HTMLElement>('[data-campo]').forEach((grupo) => {
        const err = grupo.querySelector<HTMLElement>('[data-error]');
        const texto = grupo.querySelector<HTMLInputElement | HTMLTextAreaElement>(
          'input[type="text"], input[type="email"], input[type="tel"], textarea'
        );
        const marcables = grupo.querySelectorAll<HTMLInputElement>(
          'input[type="radio"][data-required], input[type="checkbox"][data-required]'
        );

        let valido = true;
        if (texto?.required) valido = texto.value.trim().length > 0 && texto.checkValidity();
        if (marcables.length) valido = Array.from(marcables).some((m) => m.checked);

        if (!valido) {
          ok = false;
          err?.classList.remove('hidden');
          texto?.classList.add('border-red');
          primerFallo ||= grupo;
        } else {
          err?.classList.add('hidden');
          texto?.classList.remove('border-red');
        }
      });

      if (!ok && primerFallo) primerFallo.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return ok;
    };

    // ---- Render del resumen
    const titulos: Record<string, string> = {};
    form.querySelectorAll<HTMLElement>('[data-campo]').forEach((g) => {
      const nombre = g.dataset.campo!;
      titulos[nombre] = g.querySelector('label')?.childNodes[0]?.textContent?.trim() || nombre;
    });

    const pintarResumen = () => {
      const datos = new Map<string, string[]>();
      new FormData(form).forEach((v, k) => {
        if (typeof v !== 'string' || !v.trim() || k === 'empresa_web' || k === 'acepto') return;
        datos.set(k, [...(datos.get(k) || []), v]);
      });
      resumen.innerHTML = '';
      for (const [k, v] of datos) {
        const fila = document.createElement('div');
        fila.className = 'grid gap-1 border-b border-line py-3 sm:grid-cols-[1fr_1.1fr] sm:gap-4';
        const dt = document.createElement('dt');
        dt.className = 'text-[13px] text-mute-700';
        dt.textContent = titulos[k] || k;
        const dd = document.createElement('dd');
        dd.className = 'text-[14.5px] font-semibold';
        dd.textContent = v.join(' · ');
        fila.append(dt, dd);
        resumen.append(fila);
      }
    };

    // ---- Navegación
    const mostrar = (i: number) => {
      fieldsets.forEach((fs, idx) => fs.classList.toggle('hidden', idx !== i));
      actual = i;
      const esUltimo = i === total - 1;
      btnSig.classList.toggle('hidden', esUltimo);
      btnEnviar.classList.toggle('hidden', !esUltimo);
      btnAtras.disabled = i === 0;
      numPaso.textContent = String(i + 1);

      const activo = GRUPO_POR_PASO[i] ?? gruposEl.length - 1;
      gruposEl.forEach((g, gi) => {
        const on = gi === activo;
        g.classList.toggle('bg-ink', on);
        g.classList.toggle('text-paper', on);
        g.classList.toggle('text-mute-700', !on);
      });

      if (esUltimo) pintarResumen();
      cabecera.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    btnSig.addEventListener('click', () => {
      if (validarPaso(actual)) mostrar(Math.min(actual + 1, total - 1));
    });
    btnAtras.addEventListener('click', () => mostrar(Math.max(actual - 1, 0)));

    // Enter avanza en vez de enviar a medias
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA') {
        e.preventDefault();
        if (actual < total - 1) btnSig.click();
      }
    });

    // ---- Envío
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const acepto = form.querySelector<HTMLInputElement>('[name="acepto"]')!;
      const errAcepto = form.querySelector<HTMLElement>('[data-error-acepto]')!;
      if (!acepto.checked) {
        errAcepto.classList.remove('hidden');
        return;
      }
      errAcepto.classList.add('hidden');
      fallo.classList.add('hidden');
      btnEnviar.disabled = true;
      btnEnviar.textContent = 'Enviando...';

      const datos: Record<string, string> = {};
      new FormData(form).forEach((v, k) => {
        if (typeof v !== 'string') return;
        datos[k] = datos[k] ? `${datos[k]} · ${v}` : v;
      });
      datos.etiquetas = Object.entries(titulos)
        .map(([k, t]) => `${k}=${t}`)
        .join('|');

      try {
        const res = await fetch('/api/aplicar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('hidden');
        cabecera.classList.add('hidden');
        exito.classList.remove('hidden');
        exito.scrollIntoView({ behavior: 'smooth', block: 'center' });
        try {
          localStorage.removeItem(CLAVE);
        } catch {}
      } catch {
        fallo.classList.remove('hidden');
        btnEnviar.disabled = false;
        btnEnviar.textContent = 'Enviar solicitud';
      }
    });
  }
</script>
